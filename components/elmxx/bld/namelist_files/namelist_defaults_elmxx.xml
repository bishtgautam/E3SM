<?xml version="1.0"?>

<?xml-stylesheet type="text/xsl" href="namelist_defaults.xsl"?>

<namelist_defaults>

<!--
Values to use by default for creation of ELMXX model namelists.
The element names are the same as the corresponding namelist
variables.  Values that depend on the model configuration use
attributes to express the dependency.
-->

<!-- Default elmxx namelist -->

<do_elmxx>.true.</do_elmxx>

<!-- fatmlndfrc has no default: it is always set from LND_DOMAIN_PATH/LND_DOMAIN_FILE -->

<!-- fsurdat has no default: ELMXX has no -clm_usr_name equivalent to derive one
     from a naming convention, so it must be given explicitly in user_nl_elmxx -->

<elmxx_check_boundary>.true.</elmxx_check_boundary>
<elmxx_check_soft_fail>.false.</elmxx_check_soft_fail>

</namelist_defaults>
