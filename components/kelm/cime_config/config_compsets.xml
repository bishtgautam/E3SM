<?xml version="1.0"?>

<compsets>

  <help>
  Compset format is explained in cime_config/allactive/config_compsets.xml
  or in the CIME documentation
  </help>

  <!-- kELM I compsets -->

  <compset>
    <alias>IKELM</alias>
    <lname>2000_DATM%QIA_KELM_SICE_SOCN_SROF_SGLC_SWAV</lname>
  </compset>

  <compset>
    <alias>I1850KELM</alias>
    <lname>1850_DATM%QIA_KELM_SICE_SOCN_SROF_SGLC_SWAV</lname>
  </compset>

  <!-- GSWP3 forcing, as ELM's IGSWELM but with SROF; used to compare kELM
       and ELM on the same forcing -->
  <compset>
    <alias>IGSWKELM</alias>
    <lname>2000_DATM%GSWP3v1_KELM_SICE_SOCN_SROF_SGLC_SWAV</lname>
  </compset>

  <!-- kELM counterpart of ELM's IERA5ELM (ERA5 0.25 deg hourly forcing,
       DATM_MODE=ELMERA5), with SROF in place of MOSART -->
  <compset>
    <alias>IERA5KELM</alias>
    <lname>2000_DATM%ERA5_KELM_SICE_SOCN_SROF_SGLC_SWAV</lname>
  </compset>

</compsets>
